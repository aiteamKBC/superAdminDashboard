# Backend only. Do not place credentials in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional fallback when Zoom Phone recording transcription is disabled.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
ZOOM_AI_TRANSCRIPTION_ENABLED=false
ZOOM_AI_TRANSCRIPTS_PER_SYNC=10
CALLCENTRE_EMAIL_MODE=dry_run
CALLCENTRE_EMAIL_DAILY_CAP=2
# Public HTTPS origin, used for signed employer survey links.
CALLCENTRE_PUBLIC_URL=
# Production frontend HTTPS origin, particularly when TLS ends at a reverse proxy.
# CSRF_TRUSTED_ORIGINS=https://superadmin.kentbusinesscollege.net
CALLCENTRE_ESCALATION_EMAIL=
# UK bank holidays for the operating region, ISO dates separated by commas.
CALLCENTRE_HOLIDAYS=
